# Zkopíruj na .env a uprav. Pro TrueNAS Apps UI vlož hodnoty přímo do
# 'environment' v compose (UI .env nečte).

# Hesla k DB (změň!)
DB_PASSWORD=zmen-me
DB_ROOT_PASSWORD=zmen-me-root

# Port, na kterém poběží web
APP_PORT=8090

# Počáteční admin účet (založí se jen do prázdné databáze)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zmen-me-hned

# Self-update z Gitu při každém restartu kontejneru
UPDATE_ON_START=true
REPO_BRANCH=main

# Lokálně postavený image: never | veřejný GHCR: missing
# APP_PULL_POLICY=missing
